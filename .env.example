# BizBook Environment Variables
PROJECT_NAME="BizBook Enterprise"
ENVIRONMENT=development
DEBUG=True
API_V1_STR=/api/v1
SECRET_KEY=super-secret-development-jwt-key-replace-in-production-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Database
DATABASE_URL=postgresql+asyncpg://bizbook:bizbook_secret_password@localhost:5432/bizbook_db
SYNC_DATABASE_URL=postgresql://bizbook:bizbook_secret_password@localhost:5432/bizbook_db

# Redis & Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
CELERY_TASK_ALWAYS_EAGER=False

# S3 / MinIO Object Storage
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadminpassword
S3_BUCKET_NAME=bizbook-documents
S3_REGION=us-east-1

# ClamAV
CLAMAV_HOST=localhost
CLAMAV_PORT=3310

# AI Providers
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEFAULT_AI_PROVIDER=mock
